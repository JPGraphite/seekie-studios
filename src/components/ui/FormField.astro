---
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'date' | 'textarea' | 'select';
  placeholder?: string;
  required?: boolean;
  min?: string | number;
  error?: string;
  class?: string;
  options?: Array<{ label: string; value: string }>;
}

const {
  label,
  name,
  type = 'text',
  placeholder,
  required = false,
  min,
  error,
  class: className = '',
  options = [],
} = Astro.props;

const inputClass = 'w-full bg-white/[.08] border border-lemon/25 text-white placeholder:text-pink-50/50 px-3.5 py-3 rounded-xl font-body focus:outline-none focus:border-lemon focus:bg-white/[.12] transition-colors';
---
<div class:list={['field', className]}>
  <label for={name} class="block text-[12px] text-lemon tracking-[.16em] uppercase font-bold mb-1.5">
    {label}
  </label>

  {type === 'textarea' ? (
    <textarea
      id={name}
      name={name}
      placeholder={placeholder}
      required={required}
      rows={3}
      class={inputClass + ' resize-none'}
    />
  ) : type === 'select' ? (
    <select id={name} name={name} required={required} class={inputClass + ' field-select'}>
      {options.map(o => <option value={o.value}>{o.label}</option>)}
    </select>
  ) : (
    <input
      id={name}
      name={name}
      type={type}
      placeholder={placeholder}
      required={required}
      min={min}
      class={inputClass}
    />
  )}

  {error && <p class="mt-1 text-xs text-orange">{error}</p>}
</div>

<style>
  .field-select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    padding-right: var(--space-10);
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='8' viewBox='0 0 14 8' fill='none'><path d='M1 1L7 7L13 1' stroke='%23F5CF3E' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right var(--space-4) center;
    background-size: 14px 8px;
    cursor: pointer;
  }

  .field-select::-ms-expand { display: none; }

  .field-select option {
    background-color: var(--color-grape);
    color: var(--color-cream);
    font-family: var(--font-body);
    padding: var(--space-2) var(--space-3);
  }

  .field-select option:checked,
  .field-select option:hover,
  .field-select option:focus {
    background: var(--color-lemon) linear-gradient(0deg, var(--color-lemon), var(--color-lemon));
    color: var(--color-grape);
  }
</style>
