---
// Social feed integration is deferred pending library selection (Behold.so is the leading candidate).
// This component renders a static placeholder grid that matches the prototype exactly.
// Replace the placeholder grid with the embed script once the library is chosen.
---
<section class="gallery" id="feed">
  <div class="wrap">
    <div class="section-head">
      <div>
        <span class="section-tag">@seekie.studios</span>
        <h2 class="reveal">Straight from<br>the studio.</h2>
      </div>
      <p class="reveal reveal-d2">
        A live look at the canvases, the messes, the mid-paint candids. Tag us in your finished pieces —
        we love seeing where they hang.
      </p>
    </div>

    <div class="feed-tabs">
      <button class="active" data-feed="ig" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg>
        Instagram
      </button>
      <button data-feed="fb" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8a1 1 0 0 1 1-1z"/></svg>
        Facebook
      </button>
      <a href="https://instagram.com/seekie.studios" target="_blank" rel="noopener" class="view-all">View all on Instagram →</a>
    </div>

    <div class="feed-grid">
      <!-- Instagram posts -->
      <div class="post post-grad-1"><div class="ph">starry cat<br>night canvas<br>finished</div><div class="overlay"><span class="ic">♥ 482</span><span class="ic">💬 38</span></div></div>
      <div class="post post-grad-2 video"><div class="ph">timelapse<br>of the cat painting<br>2-min reel</div><div class="overlay"><span class="ic">▶ 12.4k</span><span class="ic">♥ 891</span></div></div>
      <div class="post post-grad-3"><div class="ph">birthday<br>group, easels<br>up at home</div><div class="overlay"><span class="ic">♥ 264</span><span class="ic">💬 21</span></div></div>
      <div class="post post-grad-4"><div class="ph">paint palette<br>+ wine glass<br>(top down)</div><div class="overlay"><span class="ic">♥ 198</span><span class="ic">💬 12</span></div></div>
      <div class="post post-grad-5"><div class="ph">bells beach<br>sunset canvas<br>WIP</div><div class="overlay"><span class="ic">♥ 312</span><span class="ic">💬 19</span></div></div>
      <div class="post post-grad-6 video"><div class="ph">astray bar<br>setup tour<br>reel</div><div class="overlay"><span class="ic">▶ 8.1k</span><span class="ic">♥ 540</span></div></div>
      <div class="post post-grad-7"><div class="ph">color study<br>swatches<br>flatlay</div><div class="overlay"><span class="ic">♥ 156</span><span class="ic">💬 7</span></div></div>
      <div class="post post-grad-8"><div class="ph">finished<br>canvases lined<br>up on table</div><div class="overlay"><span class="ic">♥ 421</span><span class="ic">💬 28</span></div></div>

      <!-- Facebook posts (hidden until tab toggled) -->
      <div class="post fb-post post-grad-2"><div class="ph">EVENT POST<br>Cat Under the Moon<br>Sun 24 May</div><div class="overlay"><span class="ic">👍 84</span><span class="ic">💬 22</span></div></div>
      <div class="post fb-post post-grad-1"><div class="ph">FB photo album<br>Bellarine birthday<br>32 photos</div><div class="overlay"><span class="ic">👍 156</span><span class="ic">💬 41</span></div></div>
      <div class="post fb-post post-grad-3"><div class="ph">Hens party<br>review post<br>5 stars ⭐⭐⭐⭐⭐</div><div class="overlay"><span class="ic">👍 102</span><span class="ic">💬 14</span></div></div>
      <div class="post fb-post post-grad-5"><div class="ph">Bells Beach<br>Sunset event<br>tickets live</div><div class="overlay"><span class="ic">👍 67</span><span class="ic">💬 9</span></div></div>
      <div class="post fb-post post-grad-7"><div class="ph">behind the scenes<br>packing the van<br>video</div><div class="overlay"><span class="ic">👍 51</span><span class="ic">💬 6</span></div></div>
      <div class="post fb-post post-grad-4"><div class="ph">bellarine bloom<br>SOLD OUT<br>announcement</div><div class="overlay"><span class="ic">👍 138</span><span class="ic">💬 27</span></div></div>
      <div class="post fb-post post-grad-8"><div class="ph">testimonial<br>"best night of<br>the year"</div><div class="overlay"><span class="ic">👍 89</span><span class="ic">💬 11</span></div></div>
      <div class="post fb-post post-grad-6"><div class="ph">FB live recap<br>Astray Bar<br>opening night</div><div class="overlay"><span class="ic">👍 211</span><span class="ic">💬 33</span></div></div>
    </div>
  </div>
</section>

<style>
  .gallery { background: var(--color-cream); position: relative; padding: var(--section-pad) 0; z-index: 2; }

  .section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-8); margin-bottom: var(--space-14); flex-wrap: wrap; }
  .section-head h2 { font-size: clamp(44px, 6vw, 80px); max-width: 720px; }
  .section-head p  { color: var(--color-plum); font-size: var(--text-md); max-width: 380px; }

  .feed-tabs { display: flex; gap: var(--space-2); margin-bottom: var(--space-5-5); align-items: center; }
  .feed-tabs button {
    background: var(--color-white); border: var(--border-base) solid var(--color-grape); color: var(--color-grape);
    padding: var(--space-2) var(--space-4-5); border-radius: var(--radius-pill); font-weight: 700; font-size: var(--text-tag);
    transition: var(--duration-base); display: flex; align-items: center; gap: var(--space-2); cursor: pointer;
  }
  .feed-tabs button.active { background: var(--color-grape); color: var(--color-lemon); }
  .feed-tabs button:hover:not(.active) { background: var(--color-lavender); }
  .view-all { margin-left: auto; color: var(--color-plum); font-weight: 600; font-size: var(--text-tag); text-decoration: none; }
  .view-all:hover { color: var(--color-pink); }

  .feed-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-2);
    border: var(--border-thick) solid var(--color-grape); border-radius: var(--radius-card); padding: var(--space-2); background: var(--color-white);
    box-shadow: var(--shadow-card);
  }
  @media (max-width: 1024px) { .feed-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 680px) { .feed-grid { grid-template-columns: repeat(2, 1fr); } }

  .post {
    aspect-ratio: 1/1; border-radius: var(--radius-inner); overflow: hidden; position: relative;
    background: var(--color-lavender); cursor: pointer; display: flex; align-items: flex-end; transition: var(--duration-medium);
  }
  .post:hover { transform: scale(.97); }
  .post::before { content: ""; position: absolute; pointer-events: none; }

  .ph {
    position: absolute; inset: 0; display: grid; place-items: center;
    color: var(--color-white); font-family: var(--font-mono);
    font-size: 10px; letter-spacing: .08em; text-align: center; padding: var(--space-2); line-height: 1.35;
    z-index: 2;
  }
  .overlay {
    position: relative; width: 100%; padding: var(--space-3); z-index: 2;
    background: linear-gradient(180deg, transparent, rgba(46,15,92,.85));
    color: var(--color-white); font-size: var(--text-2xs); display: flex; justify-content: space-between; align-items: center;
    opacity: 0; transition: var(--duration-medium);
  }
  .post:hover .overlay { opacity: 1; }
  .ic { display: flex; align-items: center; gap: var(--space-1); }
  .post.video::after {
    content: "▶"; position: absolute; top: var(--space-2); right: var(--space-2); color: var(--color-white); font-size: var(--text-tag);
    background: rgba(0,0,0,.4); width: 24px; height: 24px; border-radius: var(--radius-circle);
    display: grid; place-items: center; z-index: 3;
  }

  /* Post colour tiles */
  .post-grad-1 { background: var(--color-grape-deep); }
  .post-grad-1::before { top: 14%; right: 14%; width: 36%; aspect-ratio: 1; background: var(--color-lemon); border-radius: var(--radius-circle); }
  .post-grad-2 { background: var(--color-orange); }
  .post-grad-2::before { left: -15%; bottom: -20%; width: 90%; aspect-ratio: 1; background: var(--color-pink); border-radius: 55% 45% 60% 40%/45% 55% 45% 55%; }
  .post-grad-3 { background: var(--color-mint); }
  .post-grad-3::before { right: -20%; top: -15%; width: 75%; aspect-ratio: 1; background: var(--color-grape); border-radius: 60% 40% 55% 45%/50% 55% 45% 50%; }
  .post-grad-4 { background: var(--color-pink); }
  .post-grad-4::before { left: 50%; top: 50%; transform: translate(-50%,-50%); width: 60%; aspect-ratio: 1; background: var(--color-lemon); border-radius: 48% 52% 65% 35%/55% 45% 55% 45%; }
  .post-grad-5 { background: var(--color-grape); }
  .post-grad-5::before { left: -10%; bottom: -15%; width: 80%; aspect-ratio: 1; background: var(--color-orange); border-radius: 55% 45% 40% 60%/45% 60% 40% 55%; }
  .post-grad-6 { background: var(--color-grape-deep); }
  .post-grad-6::before { right: -10%; top: 50%; transform: translateY(-50%); width: 80%; aspect-ratio: 1; background: var(--color-mint); border-radius: 60% 40% 55% 45%/45% 55% 45% 55%; }
  .post-grad-7 { background: var(--color-lemon); }
  .post-grad-7::before { left: 50%; top: -25%; transform: translateX(-50%); width: 90%; aspect-ratio: 1; background: var(--color-pink); border-radius: var(--radius-circle); }
  .post-grad-8 { background: #FFD4DD; }
  .post-grad-8::before { right: -20%; bottom: -25%; width: 90%; aspect-ratio: 1; background: var(--color-orange); border-radius: 55% 45% 60% 40%/40% 60% 40% 60%; }

  /* Feed tab toggling via body class */
  .post.fb-post { display: none; }
  :global(body.feed-fb) .post:not(.fb-post) { display: none; }
  :global(body.feed-fb) .post.fb-post { display: flex; }
  :global(body.feed-ig) .post.fb-post { display: none; }
</style>
