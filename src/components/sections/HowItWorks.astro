---
import { getEntry } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';

const entry = await getEntry('settings', 'how-it-works');
const data = (entry?.data ?? {}) as {
  tag: string;
  title: string;
  subtitle: string;
  steps: Array<{ title: string; body: string; icon: string; color: string }>;
  perks: string[];
};

// Predefined icon registry - editors pick by name in the CMS
const iconPaths: Record<string, string> = {
  palette: `<path d="M3 12c0-5 4-9 9-9s9 4 9 9c0 3-2 4-4 4s-2 2-2 3 1 2-1 3c-3 1-11-2-11-10z"/><circle cx="7" cy="9" r="1.4" fill="var(--color-cream)"/><circle cx="11" cy="6" r="1.4" fill="var(--color-cream)"/><circle cx="15" cy="7" r="1.4" fill="var(--color-cream)"/><circle cx="17" cy="11" r="1.4" fill="var(--color-cream)"/>`,
  easel: `<path d="M5 21h14"/><path d="M9 21V8a3 3 0 0 1 6 0v13"/><path d="M9 12h6"/>`,
  glass: `<path d="M8 3v4l-2 2v9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9l-2-2V3"/><path d="M8 3h8"/><path d="M10 12h4"/>`,
};

const colorVar: Record<string, string> = {
  pink: 'var(--color-pink)',
  orange: 'var(--color-orange)',
  mint: 'var(--color-mint)',
  lemon: 'var(--color-lemon)',
  plum: 'var(--color-plum)',
  grape: 'var(--color-grape)',
};
---
<section class="what" id="what">
  <div class="wrap">
    <SectionHeading
      tag={data.tag}
      title={data.title}
      subtitle={data.subtitle}
    />

    <div class="feature-grid">
      {data.steps.map((step, i) => (
        <div class={`feature reveal${i > 0 ? ` reveal-d${i + 1}` : ''}`}>
          <div class="num">{String(i + 1).padStart(2, '0')}</div>
          <div class="icon-circle" style={`background:${colorVar[step.color] ?? colorVar.pink}`}>
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-cream)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[step.icon] ?? iconPaths.palette} />
          </div>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))}
    </div>

    <div class="what-rows">
      <ul>
        {data.perks.map(perk => (
          <li>
            <span class="check">✓</span>
            <div set:html={perk} />
          </li>
        ))}
      </ul>
      <div class="what-img">
        <div class="sticker">small<br>groups<br>welcome!</div>
      </div>
    </div>
  </div>
</section>

<style>
  .what { background: var(--color-cream); position: relative; padding: var(--section-pad) 0; z-index: 2; }

  .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
  @media (max-width: 1024px) { .feature-grid { grid-template-columns: 1fr; } }

  .feature {
    position: relative; background: var(--color-white); border: var(--border-thick) solid var(--color-grape);
    border-radius: var(--radius-card); padding: var(--space-8) var(--space-7);
    box-shadow: var(--shadow-card); transition: var(--duration-slow);
  }
  .feature:hover { transform: translate(-3px,-3px); box-shadow: var(--shadow-card-hover); }
  .feature .icon-circle {
    width: 64px; height: 64px; border-radius: var(--radius-circle); display: grid; place-items: center;
    margin-bottom: var(--space-5); border: var(--border-thick) solid var(--color-grape);
  }
  .feature h3 { font-family: var(--font-groove); font-size: var(--text-2xl); color: var(--color-grape); margin-bottom: var(--space-2); }
  .feature p  { color: var(--color-text-muted); font-size: var(--text-body); line-height: var(--leading-base); }
  .feature .num {
    position: absolute; top: -18px; right: 18px; width: 46px; height: 46px; border-radius: var(--radius-circle);
    background: var(--color-lemon); color: var(--color-grape); display: grid; place-items: center;
    font-family: var(--font-display); font-size: var(--text-lg); border: var(--border-thick) solid var(--color-grape);
  }

  .what-rows { margin-top: var(--space-16); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-12); align-items: center; }
  @media (max-width: 1024px) { .what-rows { grid-template-columns: 1fr; } }

  ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-3-5); }
  li {
    display: flex; align-items: flex-start; gap: var(--space-3-5); font-size: var(--text-md); color: var(--color-ink);
    padding: var(--space-3-5) var(--space-4-5); background: var(--color-lavender); border-radius: var(--radius-inner);
    box-shadow: var(--shadow-card-offset);
    border: var(--border-rule) solid var(--color-lavender); transition: var(--duration-base);
  }
  li:hover { transform: translate(-3px,-3px); box-shadow: var(--shadow-card-hover); }
  li .check {
    flex: none; width: 26px; height: 26px; border-radius: var(--radius-circle);
    background: var(--color-grape); color: var(--color-lemon);
    display: grid; place-items: center;
    font-family: var(--font-display); font-size: var(--text-tag);
  }

  .what-img {
    aspect-ratio: 4/5; border-radius: var(--radius-card); border: var(--border-rule) solid var(--color-grape);
    background: var(--color-orange); position: relative; display: grid; place-items: center;
    color: var(--color-cream); box-shadow: var(--shadow-card-offset); overflow: hidden;
  }
  .what-img::before {
    content: ""; position: absolute; left: -15%; bottom: -20%; width: 80%; aspect-ratio: 1;
    background: var(--color-pink); border-radius: 55% 45% 60% 40%/40% 60% 40% 60%;
  }
  .what-img::after {
    content: "📷  PHOTO\AGroup mid-paint, easels up,\Adrinks in hand"; white-space: pre;
    position: relative; z-index: 2;
    font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: .08em; text-align: center; padding: 24px;
  }

  .sticker {
    position: absolute; font-family: var(--font-display); color: var(--color-grape);
    background: var(--color-lemon); border: var(--border-thick) solid var(--color-grape);
    width: 120px; height: 120px; border-radius: var(--radius-circle); top: -22px; right: -22px;
    transform: rotate(-8deg); box-shadow: var(--shadow-sticker);
    font-size: var(--text-lg); line-height: var(--leading-tight); text-align: center;
    display: grid; place-items: center; z-index: 2;
  }
</style>
