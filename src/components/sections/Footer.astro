---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import { resolveSettingsImage } from '../../lib/settings-images';

const footerEntry = await getEntry('settings', 'footer');
const data = (footerEntry?.data ?? {}) as {
  logo?: string | null;
  brandName: string;
  brandSub: string;
  description: string;
  exploreHeading: string;
  exploreLinks: Array<{ label: string; href: string }>;
  contactHeading: string;
  regionsLine: string;
  legalLine: string;
  legalSubLine: string;
};

const siteEntry = await getEntry('settings', 'site');
const site = (siteEntry?.data ?? {}) as {
  email?: string;
  abn?: string;
  instagram?: string;
  facebook?: string;
};

const logo = await resolveSettingsImage(data.logo);

const socials: Array<{ name: 'instagram' | 'facebook' | 'email'; href: string; label: string }> = [];
if (site.instagram) socials.push({ name: 'instagram', href: site.instagram, label: 'Instagram' });
if (site.facebook)  socials.push({ name: 'facebook',  href: site.facebook,  label: 'Facebook' });
if (site.email)     socials.push({ name: 'email',     href: `mailto:${site.email}`, label: 'Email' });
---
<footer>
  <div class="wrap">
    <div class="grid3">
      <div class="brand-foot">
        <div class="logo">
          {logo && <Image src={logo} alt={data.brandName} width={108} height={108} />}
          <div>
            <div class="brand-name">{data.brandName}</div>
            <div class="brand-sub">{data.brandSub}</div>
          </div>
        </div>
        <p>{data.description}</p>
        <div class="socials">
          {socials.map(s => (
            <a href={s.href} target={s.name !== 'email' ? '_blank' : undefined} rel={s.name !== 'email' ? 'noopener' : undefined} aria-label={s.label}>
              <Icon name={s.name} size={18} />
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4>{data.exploreHeading}</h4>
        <ul>
          {data.exploreLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <div>
        <h4>{data.contactHeading}</h4>
        <ul>
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          {site.instagram && <li><a href={site.instagram} target="_blank" rel="noopener">DM on Instagram</a></li>}
          {site.facebook && <li><a href={site.facebook} target="_blank" rel="noopener">Message on Facebook</a></li>}
          {data.regionsLine && <li>{data.regionsLine}</li>}
        </ul>
      </div>
    </div>

    <div class="legal">
      <span>{data.legalLine}</span>
      <span>{site.abn ? `ABN ${site.abn} · ` : ''}{data.legalSubLine}</span>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--color-grape-deep); color: var(--color-lavender);
    padding: var(--section-foot-t) 0 var(--section-foot-b);
    border-top: var(--border-rule) solid var(--color-lemon);
    position: relative; z-index: 2;
  }

  .grid3 { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: var(--space-10); margin-bottom: var(--space-10); }
  @media (max-width: 680px) { .grid3 { grid-template-columns: 1fr; } }

  h4 { font-family: var(--font-display); color: var(--color-lemon); font-size: var(--text-lg); margin-bottom: var(--space-3-5); letter-spacing: var(--tracking-normal); }
  ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); }
  a  { color: var(--color-lavender-mid); text-decoration: none; font-size: var(--text-tag); }
  a:hover { color: var(--color-lemon); }

  .brand-foot { display: flex; flex-direction: column; gap: var(--space-3-5); max-width: 340px; }
  .logo { display: flex; align-items: center; gap: var(--space-3); }
  .logo :global(img) { width: 54px; height: 54px; border-radius: var(--radius-circle); border: var(--border-base) solid var(--color-lemon); object-fit: cover; }
  .brand-name { font-family: var(--font-display); color: var(--color-lemon); font-size: var(--text-xl); }
  .brand-sub  { font-size: var(--text-xs); letter-spacing: var(--tracking-label); text-transform: uppercase; color: var(--color-lavender-mid); margin-top: var(--space-1); }
  .brand-foot p { font-size: var(--text-tag); color: var(--color-lavender-mid); line-height: var(--leading-base); }

  .socials { display: flex; gap: var(--space-2); margin-top: var(--space-1); }
  .socials a {
    width: 40px; height: 40px; border-radius: var(--radius-circle); border: var(--border-fine) solid var(--color-lemon);
    display: grid; place-items: center; transition: var(--duration-base); color: var(--color-lemon);
  }
  .socials a:hover { background: var(--color-lemon); color: var(--color-grape-deep); }

  .legal {
    border-top: var(--border-fine) solid rgba(245,207,62,.2); padding-top: var(--space-6);
    display: flex; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap;
    font-size: var(--text-sm); color: var(--color-lavender-mid);
  }
</style>
