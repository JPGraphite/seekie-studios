---
import Button from '../ui/Button.astro';
---
<header class="hero">
  <div class="hero-blob b1" aria-hidden="true"></div>
  <div class="hero-blob b2" aria-hidden="true"></div>
  <div class="hero-blob b3" aria-hidden="true"></div>

  <svg class="hero-squiggle" viewBox="0 -80 1600 360" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M-100 130 C 200 40, 400 220, 700 110 S 1100 0, 1400 130 S 1700 220, 1800 110" stroke="var(--color-pink)" stroke-width="24" stroke-linecap="round"/>
    <path d="M-100 105 C 200 15, 400 195, 700 85 S 1100 -25, 1400 105 S 1700 195, 1800 85" stroke="var(--color-orange)" stroke-width="16" stroke-linecap="round"/>
    <path d="M-100 85 C 200 -5, 400 175, 700 65 S 1100 -45, 1400 85 S 1700 175, 1800 65" stroke="var(--color-lemon)" stroke-width="10" stroke-linecap="round"/>
    <path d="M-100 70 C 200 -20, 400 160, 700 50 S 1100 -60, 1400 70 S 1700 160, 1800 50" stroke="var(--color-mint)" stroke-width="6" stroke-linecap="round"/>
  </svg>
  <svg class="hero-squiggle-2" viewBox="0 0 1600 320" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M-100 140 C 250 40, 500 240, 800 120 S 1200 10, 1500 140 S 1750 240, 1800 120" stroke="var(--color-plum)" stroke-width="24" stroke-linecap="round"/>
    <path d="M-100 165 C 250 65, 500 265, 800 145 S 1200 35, 1500 165 S 1750 265, 1800 145" stroke="var(--color-pink)" stroke-width="16" stroke-linecap="round"/>
    <path d="M-100 185 C 250 85, 500 285, 800 165 S 1200 55, 1500 185 S 1750 285, 1800 165" stroke="var(--color-orange)" stroke-width="10" stroke-linecap="round"/>
    <path d="M-100 200 C 250 100, 500 300, 800 180 S 1200 70, 1500 200 S 1750 300, 1800 180" stroke="var(--color-lemon)" stroke-width="6" stroke-linecap="round"/>
  </svg>

  <div class="wrap">
    <div class="grid">
      <div>
        <div class="reveal in">
          <span class="eyebrow"><span class="dot"></span>Geelong · Surf Coast · Bellarine</span>
        </div>
        <h1 class="hero-title reveal in reveal-d2">
          Paint, <br>
          <span class="gw">sip</span>, <em>repeat.</em>
        </h1>
        <p class="lede reveal in reveal-d3">
          Private mobile paint &amp; sip parties — we roll up to your house, your venue, your bar.
          Fully BYO, custom paintings to suit your theme, all the canvases, easels &amp; aprons sorted.
          You bring the crew &amp; the playlist. 🎨
        </p>
        <div class="ctas reveal in reveal-d4">
          <Button href="#book" variant="primary">Book a private party <span class="arr">→</span></Button>
          <Button href="#events" variant="secondary">See upcoming events</Button>
        </div>

        <div class="hero-stats reveal in reveal-d4">
          <div class="s"><div class="num">2–3h</div><div class="lab">Session length</div></div>
          <div class="s"><div class="num">BYO</div><div class="lab">Drinks &amp; venue</div></div>
          <div class="s"><div class="num">∞</div><div class="lab">Custom themes</div></div>
        </div>
      </div>

      <div class="stage" aria-hidden="true">
        <div class="polaroid p1 float"><div class="img">[ photo ]<br>painters at easels<br>laughing, mid-mess</div><div class="cap">happy mess ✿</div></div>
        <div class="polaroid p2 float-2"><div class="img"></div><div class="cap">starry cat night</div></div>
        <div class="polaroid p3 float"><div class="img">[ photo ]<br>palette w/ paint blobs<br>+ wine glass</div><div class="cap">grand opening!</div></div>
        <div class="polaroid p4 float-2"><div class="img">[ photo ]<br>finished canvases<br>lined up on table</div><div class="cap">bellarine birthday</div></div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative; padding: var(--section-pad-sm) 0 var(--section-pad-lg);
    background: var(--color-lavender); overflow: hidden;
  }
  .hero-blob { position: absolute; pointer-events: none; z-index: 0; }
  .hero-blob.b1 { top: -90px; right: -60px; width: 360px; height: 360px; background: var(--color-lemon); border-radius: 62% 38% 55% 45%/45% 60% 40% 55%; transform: rotate(8deg); }
  .hero-blob.b2 { bottom: -100px; left: -80px; width: 320px; height: 320px; background: var(--color-mint); border-radius: 55% 45% 38% 62%/60% 45% 55% 40%; transform: rotate(-12deg); }
  .hero-blob.b3 { top: 40%; right: 38%; width: 120px; height: 120px; background: var(--color-pink); border-radius: 48% 52% 65% 35%/55% 45% 55% 45%; opacity: .55; transform: rotate(20deg); }

  .hero-squiggle  { position: absolute; left: -10vw; right: -10vw; top: 30px;  width: 120vw; height: 220px; pointer-events: none; z-index: 1; }
  .hero-squiggle-2 { position: absolute; left: -10vw; right: -10vw; bottom: 0; width: 120vw; height: 300px; pointer-events: none; z-index: 1; }

  .wrap { position: relative; z-index: 3; }

  .grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: var(--space-14); align-items: center; }
  @media (max-width: 1024px) { .grid { grid-template-columns: 1fr; gap: var(--space-8); } .hero { padding: var(--space-12) 0 var(--section-pad-lg); } }

  .eyebrow {
    display: inline-flex; align-items: center; gap: var(--space-2);
    background: var(--color-grape); color: var(--color-cream);
    padding: var(--space-2) var(--space-4); border-radius: var(--radius-pill);
    font-size: var(--text-xs); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; font-weight: 700;
    transform: rotate(-1.5deg);
  }
  .eyebrow .dot { width: 8px; height: 8px; border-radius: var(--radius-circle); background: var(--color-lemon); }

  h1.hero-title { font-size: clamp(56px, 9.5vw, 140px); margin: var(--space-6) 0 var(--space-5); color: var(--color-grape-deep); }
  h1.hero-title .gw  { color: var(--color-pink); }
  h1.hero-title .amp { display: inline-block; color: var(--color-orange); transform: rotate(-8deg) translateY(6px); font-family: var(--font-groove); }
  h1.hero-title em   { font-style: normal; color: var(--color-plum); position: relative; display: inline-block; }
  h1.hero-title em::after {
    content: ""; position: absolute; left: -4%; right: -4%; bottom: 6%; height: 18%;
    background: var(--color-lemon); border-radius: 50%/40%; z-index: -1; transform: rotate(-1deg);
  }

  p.lede { font-size: 20px; max-width: 680px; color: var(--color-ink); margin-bottom: var(--space-8); }
  .ctas  { display: flex; flex-wrap: wrap; gap: var(--space-3-5); align-items: center; }
  .arr   { transition: var(--duration-base); display: inline-block; }
  :global(.btn:hover) .arr, :global(a:hover) .arr { transform: translateX(4px); }

  .hero-stats { display: flex; gap: var(--space-7); margin-top: var(--space-10); flex-wrap: wrap; }
  .hero-stats .s   { display: flex; align-items: baseline; gap: var(--space-2); }
  .hero-stats .num { font-family: var(--font-display); font-size: var(--text-3xl); color: var(--color-orange); line-height: var(--leading-tight); }
  .hero-stats .lab { font-size: var(--text-sm); color: var(--color-grape); font-weight: 600; max-width: 120px; line-height: var(--leading-snug); }

  /* Polaroid stage */
  .stage { position: relative; height: 680px; }
  @media (max-width: 1024px) { .stage { height: 360px; } }

  .polaroid {
    position: absolute; background: var(--color-white); padding: 14px 14px 56px;
    box-shadow: 0 18px 36px -10px rgba(74,31,140,.35), 0 4px 12px rgba(74,31,140,.15);
    border-radius: 2px;
    transition: transform .4s cubic-bezier(.2,.9,.3,1.3);
  }
  .polaroid .img {
    width: 100%; aspect-ratio: 3/4; border-radius: 1px;
    display: flex; align-items: center; justify-content: center;
    background-color: var(--color-plum); color: var(--color-white);
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: .08em;
    text-align: center; padding: var(--space-3); line-height: var(--leading-compact);
  }
  .polaroid .cap { font-family: var(--font-hand); font-size: var(--text-xl); color: var(--color-grape); text-align: center; margin-top: var(--space-2); line-height: var(--leading-tight); }
  .polaroid:hover { transform: scale(1.04) rotate(0deg) !important; z-index: 5; }

  .p1 { top: 30px;  left: 0;    width: 240px; transform: rotate(-7deg); }
  .p2 { top: 80px;  left: 200px; width: 280px; transform: rotate(4deg);  z-index: 2; }
  .p3 { top: 240px; left: 60px;  width: 230px; transform: rotate(-3deg); z-index: 3; }
  .p4 { top: 300px; left: 280px; width: 220px; transform: rotate(8deg);  z-index: 1; }

  .p2 .img { background: var(--color-grape-deep); position: relative; overflow: hidden; }
  .p2 .img::before { content: ""; position: absolute; top: 14%; right: 18%; width: 30%; aspect-ratio: 1; background: var(--color-lemon); border-radius: var(--radius-circle); }
  .p2 .img::after  { content: "🐈‍⬛"; font-size: 88px; filter: saturate(0); position: relative; z-index: 2; }
  .p1 .img { background-color: var(--color-pink); }
  .p3 .img { background-color: var(--color-orange); }
  .p4 .img { background-color: var(--color-mint); }

  @media (max-width: 1024px) {
    .p1 { top: 16px;  left: 0;    width: 148px; }
    .p2 { top: 48px;  left: 124px; width: 168px; }
    .p3 { top: 148px; left: 36px;  width: 140px; }
    .p4 { top: 182px; left: 176px; width: 134px; }
    .p2 .img::after { font-size: 52px; }
  }
</style>
