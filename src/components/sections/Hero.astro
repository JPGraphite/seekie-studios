---
import Button from '../ui/Button.astro';
---
<header class="hero">
  <div class="hero-blob b1" aria-hidden="true"></div>
  <div class="hero-blob b2" aria-hidden="true"></div>
  <div class="hero-blob b3" aria-hidden="true"></div>

  <svg class="hero-squiggle" viewBox="0 0 1600 200" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M-100 130 C 200 40, 400 220, 700 110 S 1100 0, 1400 130 S 1700 220, 1800 110" stroke="#EC3B8E" stroke-width="24" stroke-linecap="round"/>
    <path d="M-100 105 C 200 15, 400 195, 700 85 S 1100 -25, 1400 105 S 1700 195, 1800 85" stroke="#F37A2B" stroke-width="16" stroke-linecap="round"/>
    <path d="M-100 85 C 200 -5, 400 175, 700 65 S 1100 -45, 1400 85 S 1700 175, 1800 65" stroke="#F5CF3E" stroke-width="10" stroke-linecap="round"/>
    <path d="M-100 70 C 200 -20, 400 160, 700 50 S 1100 -60, 1400 70 S 1700 160, 1800 50" stroke="#6CD7C2" stroke-width="6" stroke-linecap="round"/>
  </svg>
  <svg class="hero-squiggle-2" viewBox="0 0 1600 220" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path d="M-100 140 C 250 40, 500 240, 800 120 S 1200 10, 1500 140 S 1750 240, 1800 120" stroke="#7B36C7" stroke-width="24" stroke-linecap="round"/>
    <path d="M-100 165 C 250 65, 500 265, 800 145 S 1200 35, 1500 165 S 1750 265, 1800 145" stroke="#EC3B8E" stroke-width="16" stroke-linecap="round"/>
    <path d="M-100 185 C 250 85, 500 285, 800 165 S 1200 55, 1500 185 S 1750 285, 1800 165" stroke="#F37A2B" stroke-width="10" stroke-linecap="round"/>
    <path d="M-100 200 C 250 100, 500 300, 800 180 S 1200 70, 1500 200 S 1750 300, 1800 180" stroke="#F5CF3E" stroke-width="6" stroke-linecap="round"/>
  </svg>

  <div class="wrap">
    <div class="grid">
      <div>
        <div class="reveal in">
          <span class="eyebrow"><span class="dot"></span>Geelong · Surf Coast · Bellarine</span>
        </div>
        <h1 class="hero-title reveal in reveal-d2">
          Paint, <span class="amp">&amp;</span><br>
          <span class="gw">sip</span>, <em>repeat.</em>
        </h1>
        <p class="lede reveal in reveal-d3">
          Private mobile paint &amp; sip parties — we roll up to your house, your venue, your bar.
          Fully BYO, custom paintings to suit your theme, all the canvases, easels &amp; aprons sorted.
          You bring the crew &amp; the playlist. 🎨
        </p>
        <div class="ctas reveal in reveal-d4">
          <Button href="#book" variant="primary">Book a private party <span class="arr">→</span></Button>
          <Button href="#events" variant="secondary">See upcoming events</Button>
        </div>

        <div class="hero-stats reveal in reveal-d4">
          <div class="s"><div class="num">2–3h</div><div class="lab">Session length</div></div>
          <div class="s"><div class="num">BYO</div><div class="lab">Drinks &amp; venue</div></div>
          <div class="s"><div class="num">∞</div><div class="lab">Custom themes</div></div>
        </div>
      </div>

      <div class="stage" aria-hidden="true">
        <div class="polaroid p1 float"><div class="img">[ photo ]<br>painters at easels<br>laughing, mid-mess</div><div class="cap">happy mess ✿</div></div>
        <div class="polaroid p2 float-2"><div class="img"></div><div class="cap">starry cat night</div></div>
        <div class="polaroid p3 float"><div class="img">[ photo ]<br>palette w/ paint blobs<br>+ wine glass</div><div class="cap">grand opening!</div></div>
        <div class="polaroid p4 float-2"><div class="img">[ photo ]<br>finished canvases<br>lined up on table</div><div class="cap">bellarine birthday</div></div>
      </div>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative; padding: 90px 0 140px;
    background: #EFD9FF; overflow: hidden;
  }
  .hero-blob { position: absolute; pointer-events: none; z-index: 0; }
  .hero-blob.b1 { top: -90px; right: -60px; width: 360px; height: 360px; background: #F5CF3E; border-radius: 62% 38% 55% 45%/45% 60% 40% 55%; transform: rotate(8deg); }
  .hero-blob.b2 { bottom: -100px; left: -80px; width: 320px; height: 320px; background: #6CD7C2; border-radius: 55% 45% 38% 62%/60% 45% 55% 40%; transform: rotate(-12deg); }
  .hero-blob.b3 { top: 40%; right: 38%; width: 120px; height: 120px; background: #EC3B8E; border-radius: 48% 52% 65% 35%/55% 45% 55% 45%; opacity: .55; transform: rotate(20deg); }

  .hero-squiggle  { position: absolute; left: -10vw; right: -10vw; top: 30px;  width: 120vw; height: 200px; pointer-events: none; z-index: 1; }
  .hero-squiggle-2 { position: absolute; left: -10vw; right: -10vw; bottom: 0; width: 120vw; height: 220px; pointer-events: none; z-index: 1; }

  .wrap { position: relative; z-index: 3; }

  .grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: 56px; align-items: center; }
  @media (max-width: 880px) { .grid { grid-template-columns: 1fr; gap: 32px; } .hero { padding: 48px 0 90px; } }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    background: #4A1F8C; color: #FFF6E8;
    padding: 8px 16px; border-radius: 999px;
    font-size: 12px; letter-spacing: .22em; text-transform: uppercase; font-weight: 700;
    transform: rotate(-1.5deg);
  }
  .eyebrow .dot { width: 8px; height: 8px; border-radius: 50%; background: #F5CF3E; }

  h1.hero-title { font-size: clamp(56px, 9.5vw, 140px); margin: 24px 0 20px; color: #2E0F5C; }
  h1.hero-title .gw  { color: #EC3B8E; }
  h1.hero-title .amp { display: inline-block; color: #F37A2B; transform: rotate(-8deg) translateY(6px); font-family: "Caprasimo", serif; }
  h1.hero-title em   { font-style: normal; color: #7B36C7; position: relative; display: inline-block; }
  h1.hero-title em::after {
    content: ""; position: absolute; left: -4%; right: -4%; bottom: 6%; height: 18%;
    background: #F5CF3E; border-radius: 50%/40%; z-index: -1; transform: rotate(-1deg);
  }

  p.lede { font-size: 20px; max-width: 540px; color: #2A0F4F; margin-bottom: 32px; }
  .ctas  { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  .arr   { transition: .2s; display: inline-block; }
  :global(.btn:hover) .arr, :global(a:hover) .arr { transform: translateX(4px); }

  .hero-stats { display: flex; gap: 28px; margin-top: 42px; flex-wrap: wrap; }
  .hero-stats .s   { display: flex; align-items: baseline; gap: 10px; }
  .hero-stats .num { font-family: "Bagel Fat One", serif; font-size: 34px; color: #F37A2B; line-height: 1; }
  .hero-stats .lab { font-size: 13px; color: #4A1F8C; font-weight: 600; max-width: 120px; line-height: 1.25; }

  /* Polaroid stage */
  .stage { position: relative; height: 560px; }
  @media (max-width: 880px) { .stage { height: 460px; } }

  .polaroid {
    position: absolute; background: #fff; padding: 14px 14px 56px;
    box-shadow: 0 18px 36px -10px rgba(74,31,140,.35), 0 4px 12px rgba(74,31,140,.15);
    border-radius: 2px;
    transition: transform .4s cubic-bezier(.2,.9,.3,1.3);
  }
  .polaroid .img {
    width: 100%; aspect-ratio: 3/4; border-radius: 1px;
    display: flex; align-items: center; justify-content: center;
    background-color: #7B36C7; color: #fff;
    font-family: "DM Mono", "Courier New", monospace; font-size: 12px; letter-spacing: .08em;
    text-align: center; padding: 12px; line-height: 1.4;
  }
  .polaroid .cap { font-family: "Caveat", cursive; font-size: 22px; color: #4A1F8C; text-align: center; margin-top: 10px; line-height: 1; }
  .polaroid:hover { transform: scale(1.04) rotate(0deg) !important; z-index: 5; }

  .p1 { top: 30px;  left: 0;    width: 240px; transform: rotate(-7deg); }
  .p2 { top: 80px;  left: 200px; width: 280px; transform: rotate(4deg);  z-index: 2; }
  .p3 { top: 240px; left: 60px;  width: 230px; transform: rotate(-3deg); z-index: 3; }
  .p4 { top: 300px; left: 280px; width: 220px; transform: rotate(8deg);  z-index: 1; }

  .p2 .img { background: #3a1a6a; position: relative; overflow: hidden; }
  .p2 .img::before { content: ""; position: absolute; top: 14%; right: 18%; width: 30%; aspect-ratio: 1; background: #F5CF3E; border-radius: 50%; }
  .p2 .img::after  { content: "🐈‍⬛"; font-size: 88px; filter: saturate(0); position: relative; z-index: 2; }
  .p1 .img { background-color: #EC3B8E; }
  .p3 .img { background-color: #F37A2B; }
  .p4 .img { background-color: #6CD7C2; }
</style>
