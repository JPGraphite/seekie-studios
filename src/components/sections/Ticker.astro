---
const items = [
  'BYO drinks',
  'We come to you',
  'Custom themes',
  'Hens · birthdays · book club · just because',
  'Mocktails welcome',
  'No skills required',
];
---
<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <span>
      {items.map(item => (
        <>
          <em>{item}</em><span class="star">✺</span>
        </>
      ))}
    </span>
    <span aria-hidden="true">
      {items.map(item => (
        <>
          <em>{item}</em><span class="star">✺</span>
        </>
      ))}
    </span>
  </div>
</div>

<style>
  .ticker {
    background: var(--color-grape); color: var(--color-lemon);
    border-top: var(--border-rule) solid var(--color-ink); border-bottom: var(--border-rule) solid var(--color-ink);
    overflow: hidden;
    font-family: var(--font-display); font-size: var(--text-3xl); letter-spacing: var(--tracking-normal);
    padding: var(--space-3-5) 0;
  }
  .ticker-track { display: flex; gap: var(--space-12); white-space: nowrap; }
  .ticker-track span { display: inline-flex; align-items: center; gap: var(--space-12); }
  .star { color: var(--color-pink); font-size: var(--text-xl); }
</style>
