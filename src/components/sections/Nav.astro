---
import Button from '../ui/Button.astro';
---
<nav class="top">
  <div class="wrap row">
    <a href="/" class="brand">
      <img src="/assets/logo-pink.jpg" alt="Seekie Studios logo" width="54" height="54" />
      <div>
        <div class="bn">Seekie Studios</div>
        <div class="bs">Paint · Sip · Geelong</div>
      </div>
    </a>

    <ul>
      <li><a href="#what">What we do</a></li>
      <li><a href="#events">Events</a></li>
      <li><a href="#astray">Astray Bar</a></li>
      <li><a href="#feed">The Feed</a></li>
      <li><a href="#book">Book</a></li>
    </ul>

    <Button href="#book" variant="nav" size="sm">Book a Party →</Button>
  </div>
</nav>

<style>
  .top {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(8px);
    background: rgba(239,217,255,.78);
    border-bottom: 2px solid #4A1F8C;
  }
  .row {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 14px 0;
  }
  .brand {
    display: flex; align-items: center; gap: 12px; text-decoration: none;
  }
  .brand img {
    width: 54px; height: 54px; border-radius: 50%;
    border: 2px solid #4A1F8C; background: #FFD4DD; object-fit: cover;
  }
  .bn { font-family: "Bagel Fat One", serif; font-size: 22px; color: #4A1F8C; line-height: 1; }
  .bs { font-family: "DM Sans", sans-serif; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: #7B36C7; margin-top: 4px; }

  ul { display: flex; gap: 28px; list-style: none; }
  ul a {
    text-decoration: none; font-weight: 600; font-size: 15px; color: #4A1F8C;
    padding: 6px 2px; border-bottom: 2px solid transparent; transition: .2s;
  }
  ul a:hover { border-color: #EC3B8E; }

  @media (max-width: 820px) { ul { display: none; } }
</style>
