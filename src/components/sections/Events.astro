---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

const allEvents = await getCollection('events');
const events = allEvents.sort((a, b) => a.data.order - b.data.order);

// Pre-import all event cover images for Astro optimization (available at build time via Keystatic git commits)
const coverModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/events/**/*.{jpg,jpeg,png,webp,avif,gif}');
const coverImages: Record<string, ImageMetadata> = {};
for (const event of events) {
  if (event.data.cover) {
    const mod = coverModules[event.data.cover];
    if (mod) coverImages[event.id] = (await mod()).default;
  }
}

// Cover blob patterns keyed by coverVariant
const coverStyles: Record<string, string> = {
  'grape-moon':  'background:var(--color-grape-deep)',
  'orange-blobs': 'background:var(--color-orange)',
  'grape-mint':  'background:var(--color-grape)',
  'default':     'background:var(--color-grape)',
};
---
<section class="events" id="events">
  <div class="wrap">
    <SectionHeading
      tag="upcoming events"
      title="Grab a seat,<br>grab a glass."
      subtitle="Public events run at partner venues across the region. Tickets via Humanitix or our Facebook event page — seats are limited & usually go fast."
    />

    <div class="event-grid">
      {events.map((event, i) => {
        const d = event.data;
        const isSoldOut = d.status === 'sold-out';
        const isWaitlist = d.status === 'waitlist';
        const delay = i > 0 ? ` reveal-d${i + 1}` : '';

        return (
          <article class={`event event-${i + 1} reveal${delay}`}>
            <div class="cover" style={coverImages[event.id] ? '' : (coverStyles[d.coverVariant] ?? coverStyles.default)}>
              {coverImages[event.id]
                ? <Image src={coverImages[event.id]} alt={d.title} class="cover-img" widths={[400, 600]} sizes="(max-width: 680px) 100vw, (max-width: 1024px) 50vw, 33vw" />
                : <>
                    <div class={`blob-shape variant-${d.coverVariant}`} aria-hidden="true"></div>
                    <div class="ph">[ event photo ]</div>
                  </>
              }
              <span class="pricetag">${d.price}pp</span>
            </div>

            <div class="body">
              <div class="when">
                <span class="dot"></span>
                {new Date(d.date + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'long' })} · {d.time}
              </div>
              <h3>{d.title}</h3>
              <div class="meta">
                <span><Icon name="location" size={14} />  {d.venue} · {d.venueAddress}</span>
                <span><Icon name="clock" size={14} />  {d.duration}</span>
              </div>
              <div class="foot">
                <div class="seats">
                  {isSoldOut ? (
                    <b>SOLD OUT</b>
                  ) : isWaitlist ? (
                    <><b>{d.seatsLeft}</b> seats left of {d.totalSeats}</>
                  ) : (
                    <><b>{d.seatsLeft}</b> seats left of {d.totalSeats}</>
                  )}
                </div>
                <a
                  href={d.ticketUrl}
                  target="_blank"
                  rel="noopener"
                  class={isSoldOut || isWaitlist ? 'ticket waitlist' : 'ticket'}
                >
                  {isSoldOut ? 'Waitlist →' : 'Humanitix →'}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="humanitix-note">
      <span>Tickets powered by</span>
      <span class="pill">Humanitix</span>
      <span>· also bookable via our Facebook event pages.</span>
    </div>
  </div>
</section>

<style>
  .events { background: var(--color-lavender); position: relative; padding: var(--section-pad) 0; z-index: 2; }

  .event-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5-5); }
  @media (max-width: 1024px) { .event-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px) { .event-grid { grid-template-columns: 1fr; } }

  .event {
    position: relative; background: var(--color-white); border: var(--border-thick) solid var(--color-grape); border-radius: var(--radius-card);
    overflow: hidden; display: flex; flex-direction: column;
    box-shadow: var(--shadow-card); transition: var(--duration-slow);
  }
  .event:hover { transform: translate(-3px,-3px); box-shadow: var(--shadow-card-hover); }

  .cover {
    aspect-ratio: 5/4; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    border-bottom: var(--border-thick) solid var(--color-grape);
  }

  /* Blob patterns per cover variant */
  .blob-shape { position: absolute; pointer-events: none; }
  .variant-grape-moon {
    top: 8%; right: 10%; width: 46%; aspect-ratio: 1;
    background: var(--color-lemon); border-radius: var(--radius-circle); box-shadow: -30px 30px 0 -10px var(--color-lemon);
  }
  .variant-orange-blobs {
    left: -10%; top: -10%; width: 80%; aspect-ratio: 1;
    background: var(--color-pink); border-radius: 60% 40% 55% 45%/50% 55% 45% 50%;
  }
  .variant-grape-mint {
    left: 50%; top: 50%; transform: translate(-50%,-50%); width: 78%; aspect-ratio: 1;
    background: var(--color-mint); border-radius: 55% 45% 60% 40%/45% 55% 45% 55%;
  }
  .variant-default {
    left: 50%; top: 50%; transform: translate(-50%,-50%); width: 60%; aspect-ratio: 1;
    background: var(--color-pink); border-radius: var(--radius-circle);
  }

  .cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .pricetag {
    position: absolute; top: var(--space-3-5); right: var(--space-3-5);
    background: var(--color-lemon); color: var(--color-grape);
    border: var(--border-thick) solid var(--color-grape); padding: var(--space-1) var(--space-3-5); border-radius: var(--radius-pill);
    font-family: var(--font-display); font-size: 16px; z-index: 2;
  }
  .ph {
    color: var(--color-white); font-family: var(--font-mono); font-size: var(--text-2xs);
    letter-spacing: var(--tracking-meta); text-align: center; padding: var(--space-4); line-height: var(--leading-compact);
    mix-blend-mode: plus-lighter; position: relative; z-index: 2;
  }

  .body { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }

  .when { display: flex; align-items: center; gap: var(--space-2); color: var(--color-pink); font-weight: 700; font-size: var(--text-sm); letter-spacing: var(--tracking-meta); text-transform: uppercase; }
  .when .dot { width: 8px; height: 8px; background: var(--color-pink); border-radius: var(--radius-circle); flex: none; }
  h3 { font-family: var(--font-groove); font-size: var(--text-2xl); color: var(--color-grape); line-height: var(--leading-tight); }

  .meta { display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--text-tag); color: var(--color-text-muted); }
  .meta span { display: flex; align-items: center; gap: var(--space-2); }

  .foot {
    margin-top: auto; padding-top: var(--space-3-5); border-top: var(--border-fine) dashed var(--color-lavender-mid);
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
  }
  .seats { font-size: var(--text-xs); color: var(--color-plum); font-weight: 600; }
  .seats b { color: var(--color-orange); }

  .ticket {
    background: var(--color-grape); color: var(--color-lemon); padding: var(--space-2) var(--space-3-5); border-radius: var(--radius-pill);
    text-decoration: none; font-family: var(--font-display); font-size: var(--text-sm); letter-spacing: var(--tracking-normal);
  }
  .ticket:hover   { background: var(--color-pink); color: var(--color-white); }
  .ticket.waitlist { background: var(--color-plum); }

  .humanitix-note {
    margin-top: var(--space-10); display: flex; align-items: center; justify-content: center; gap: var(--space-3-5);
    color: var(--color-plum); font-size: var(--text-tag); flex-wrap: wrap; text-align: center;
  }
  .humanitix-note .pill {
    background: var(--color-white); border: var(--border-base) solid var(--color-grape); padding: var(--space-1) var(--space-3-5); border-radius: var(--radius-pill);
    font-family: var(--font-display); color: var(--color-grape); font-size: var(--text-sm);
  }
</style>
