---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

const allEvents = await getCollection('events');
const events = allEvents.sort((a, b) => a.data.order - b.data.order);

// Pre-import all event cover images for Astro optimization (available at build time via Keystatic git commits)
const coverModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/events/**/*.{jpg,jpeg,png,webp,avif,gif}');
const coverImages: Record<string, ImageMetadata> = {};
for (const event of events) {
  if (event.data.cover) {
    const mod = coverModules[event.data.cover];
    if (mod) coverImages[event.id] = (await mod()).default;
  }
}

// Cover blob patterns keyed by coverVariant
const coverStyles: Record<string, string> = {
  'grape-moon':  'background:#3a1a6a',
  'orange-blobs': 'background:#F37A2B',
  'grape-mint':  'background:#4A1F8C',
  'default':     'background:#4A1F8C',
};
---
<section class="events" id="events">
  <div class="wrap">
    <SectionHeading
      tag="upcoming events"
      title="Grab a seat,<br>grab a glass."
      subtitle="Public events run at partner venues across the region. Tickets via Humanitix or our Facebook event page — seats are limited & usually go fast."
    />

    <div class="event-grid">
      {events.map((event, i) => {
        const d = event.data;
        const isSoldOut = d.status === 'sold-out';
        const isWaitlist = d.status === 'waitlist';
        const delay = i > 0 ? ` reveal-d${i + 1}` : '';

        return (
          <article class={`event event-${i + 1} reveal${delay}`}>
            <div class="cover" style={coverImages[event.id] ? '' : (coverStyles[d.coverVariant] ?? coverStyles.default)}>
              {coverImages[event.id]
                ? <Image src={coverImages[event.id]} alt={d.title} class="cover-img" widths={[400, 600]} sizes="(max-width: 680px) 100vw, (max-width: 980px) 50vw, 33vw" />
                : <>
                    <div class={`blob-shape variant-${d.coverVariant}`} aria-hidden="true"></div>
                    <div class="ph">[ event photo ]</div>
                  </>
              }
              <span class="pricetag">${d.price}pp</span>
            </div>

            <div class="body">
              <div class="when">
                <span class="dot"></span>
                {new Date(d.date + 'T00:00:00').toLocaleDateString('en-AU', { weekday: 'short', day: 'numeric', month: 'long' })} · {d.time}
              </div>
              <h3>{d.title}</h3>
              <div class="meta">
                <span><Icon name="location" size={14} />  {d.venue} · {d.venueAddress}</span>
                <span><Icon name="clock" size={14} />  {d.duration}</span>
              </div>
              <div class="foot">
                <div class="seats">
                  {isSoldOut ? (
                    <b>SOLD OUT</b>
                  ) : isWaitlist ? (
                    <><b>{d.seatsLeft}</b> seats left of {d.totalSeats}</>
                  ) : (
                    <><b>{d.seatsLeft}</b> seats left of {d.totalSeats}</>
                  )}
                </div>
                <a
                  href={d.ticketUrl}
                  target="_blank"
                  rel="noopener"
                  class={isSoldOut || isWaitlist ? 'ticket waitlist' : 'ticket'}
                >
                  {isSoldOut ? 'Waitlist →' : 'Humanitix →'}
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="humanitix-note">
      <span>Tickets powered by</span>
      <span class="pill">Humanitix</span>
      <span>· also bookable via our Facebook event pages.</span>
    </div>
  </div>
</section>

<style>
  .events { background: #EFD9FF; position: relative; padding: 110px 0; z-index: 2; }

  .event-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  @media (max-width: 980px) { .event-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px) { .event-grid { grid-template-columns: 1fr; } }

  .event {
    position: relative; background: #fff; border: 2.5px solid #4A1F8C; border-radius: 24px;
    overflow: hidden; display: flex; flex-direction: column;
    box-shadow: 6px 6px 0 #4A1F8C; transition: .3s;
  }
  .event:hover { transform: translate(-3px,-3px); box-shadow: 9px 9px 0 #4A1F8C; }

  .cover {
    aspect-ratio: 5/4; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    border-bottom: 2.5px solid #4A1F8C;
  }

  /* Blob patterns per cover variant */
  .blob-shape { position: absolute; pointer-events: none; }
  .variant-grape-moon {
    top: 8%; right: 10%; width: 46%; aspect-ratio: 1;
    background: #F5CF3E; border-radius: 50%; box-shadow: -30px 30px 0 -10px #F5CF3E;
  }
  .variant-orange-blobs {
    left: -10%; top: -10%; width: 80%; aspect-ratio: 1;
    background: #EC3B8E; border-radius: 60% 40% 55% 45%/50% 55% 45% 50%;
  }
  .variant-grape-mint {
    left: 50%; top: 50%; transform: translate(-50%,-50%); width: 78%; aspect-ratio: 1;
    background: #6CD7C2; border-radius: 55% 45% 60% 40%/45% 55% 45% 55%;
  }
  .variant-default {
    left: 50%; top: 50%; transform: translate(-50%,-50%); width: 60%; aspect-ratio: 1;
    background: #EC3B8E; border-radius: 50%;
  }

  .cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .pricetag {
    position: absolute; top: 14px; right: 14px;
    background: #F5CF3E; color: #4A1F8C;
    border: 2.5px solid #4A1F8C; padding: 6px 14px; border-radius: 999px;
    font-family: "Bagel Fat One", serif; font-size: 16px; z-index: 2;
  }
  .ph {
    color: #fff; font-family: "DM Mono", "Courier New", monospace; font-size: 11px;
    letter-spacing: .1em; text-align: center; padding: 16px; line-height: 1.4;
    mix-blend-mode: plus-lighter; position: relative; z-index: 2;
  }

  .body { padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 12px; flex: 1; }

  .when { display: flex; align-items: center; gap: 8px; color: #EC3B8E; font-weight: 700; font-size: 13px; letter-spacing: .1em; text-transform: uppercase; }
  .when .dot { width: 8px; height: 8px; background: #EC3B8E; border-radius: 50%; flex: none; }
  h3 { font-family: "Caprasimo", serif; font-size: 26px; color: #4A1F8C; line-height: 1.05; }

  .meta { display: flex; flex-direction: column; gap: 6px; font-size: 14px; color: #3d2666; }
  .meta span { display: flex; align-items: center; gap: 8px; }

  .foot {
    margin-top: auto; padding-top: 14px; border-top: 1.5px dashed #E1BFFF;
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
  }
  .seats { font-size: 12px; color: #7B36C7; font-weight: 600; }
  .seats b { color: #F37A2B; }

  .ticket {
    background: #4A1F8C; color: #F5CF3E; padding: 10px 14px; border-radius: 999px;
    text-decoration: none; font-family: "Bagel Fat One", serif; font-size: 13px; letter-spacing: .04em;
  }
  .ticket:hover   { background: #EC3B8E; color: #fff; }
  .ticket.waitlist { background: #7B36C7; }

  .humanitix-note {
    margin-top: 38px; display: flex; align-items: center; justify-content: center; gap: 14px;
    color: #7B36C7; font-size: 14px; flex-wrap: wrap; text-align: center;
  }
  .humanitix-note .pill {
    background: #fff; border: 2px solid #4A1F8C; padding: 6px 14px; border-radius: 999px;
    font-family: "Bagel Fat One", serif; color: #4A1F8C; font-size: 13px;
  }
</style>
