---
import { getEntry } from 'astro:content';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const entry = await getEntry('settings', 'astray-bar');
const data = (entry?.data ?? {}) as {
  tag: string;
  title: string;
  lede: string;
  ctaLabel: string;
  ctaHref: string;
  perks: Array<{ icon: string; heading: string; body: string }>;
  nextSession: {
    label: string;
    heading: string;
    headingAccent: string;
    dateLine: string;
    venueLine: string;
    priceLine: string;
    hostBy: string;
    hostAt: string;
  };
};
---
<section class="astray" id="astray">
  <svg class="deco-svg" viewBox="0 0 400 200" aria-hidden="true">
    <path d="M-20 100 C 40 20, 100 180, 160 100 S 280 20, 340 100 S 460 180, 520 100" stroke="var(--color-lemon)" stroke-width="14" stroke-linecap="round" fill="none"/>
    <path d="M-20 100 C 40 20, 100 180, 160 100 S 280 20, 340 100 S 460 180, 520 100" stroke="var(--color-pink)" stroke-width="8" stroke-linecap="round" fill="none" transform="translate(0,-20)"/>
  </svg>

  <div class="wrap">
    <div class="grid2">
      <div>
        <SectionHeading
          tag={data.tag}
          title={data.title}
          tagColor="var(--color-mint)"
          titleColor="var(--color-lemon)"
          align="left"
        />
        <p class="lede2 reveal reveal-d2" set:html={data.lede} />

        <div class="perks">
          {data.perks.map((p, i) => (
            <div class={`perk reveal${i > 0 ? ` reveal-d${i + 1}` : ''}`}>
              <h4>{p.icon} {p.heading}</h4>
              <p>{p.body}</p>
            </div>
          ))}
        </div>

        <Button href={data.ctaHref} variant="primary">{data.ctaLabel} <span class="arr">→</span></Button>
      </div>

      <div class="astray-card reveal reveal-d2">
        <span class="label">{data.nextSession.label}</span>
        <h3>{data.nextSession.heading} <span>{data.nextSession.headingAccent}</span></h3>
        <ul class="menu-list">
          <li>{data.nextSession.dateLine}</li>
          <li>{data.nextSession.venueLine}</li>
          <li>{data.nextSession.priceLine}</li>
        </ul>
        <div class="meta">
          <span><b>Run by</b> {data.nextSession.hostBy}</span>
          <span><b>Hosted at</b> {data.nextSession.hostAt}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .astray {
    background: var(--color-grape); color: var(--color-cream);
    position: relative; overflow: hidden; padding: var(--section-pad) 0; z-index: 2;
  }

  .deco-svg {
    position: absolute; top: 60px; right: 0px; width: 100%; opacity: .5;
    pointer-events: none;
  }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-16); align-items: center; }
  @media (max-width: 1024px) { .grid2 { grid-template-columns: 1fr; } }

  .lede2 { font-size: 19px; color: #F8E8FF; max-width: 680px; line-height: var(--leading-base); margin-bottom: var(--space-6); }

  .perks { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3-5); margin: var(--space-7) 0 var(--space-8); }
  .perk {
    background: rgba(255,255,255,.06); border: var(--border-fine) solid rgba(245,207,62,.3);
    border-radius: var(--radius-badge); padding: var(--space-4) var(--space-4-5);
  }
  .perk h4 { font-family: var(--font-groove); font-size: var(--text-lg); color: var(--color-lemon); margin-bottom: var(--space-1); }
  .perk p  { font-size: var(--text-tag); color: #F8E8FF; line-height: var(--leading-compact); }

  .astray-card {
    position: relative; aspect-ratio: 4/5;
    background: var(--color-grape-deep); border: var(--border-rule) solid var(--color-lemon); border-radius: var(--radius-card);
    padding: var(--space-7); display: flex; flex-direction: column; justify-content: flex-end;
    box-shadow: 0 24px 60px -10px rgba(0,0,0,.45); overflow: hidden;
  }
  .astray-card::before {
    content: ""; position: absolute; top: -12%; right: -15%; width: 65%; aspect-ratio: 1;
    background: var(--color-pink); border-radius: 55% 45% 60% 40%/45% 55% 45% 55%;
  }
  .astray-card::after {
    content: ""; position: absolute; left: -10%; bottom: -15%; width: 55%; aspect-ratio: 1;
    background: var(--color-lemon); border-radius: var(--radius-circle);
  }

  .label {
    position: relative; display: inline-block; align-self: flex-start; margin-bottom: auto;
    background: var(--color-lemon); color: var(--color-grape);
    padding: var(--space-2) var(--space-3-5); border-radius: var(--radius-pill);
    font-family: var(--font-display); font-size: var(--text-tag); letter-spacing: .06em;
  }
  h3 {
    position: relative; font-family: var(--font-display); font-size: var(--text-5xl);
    color: var(--color-cream); line-height: var(--leading-heading); margin-bottom: var(--space-3-5);
  }
  h3 span { color: var(--color-lemon); }

  .menu-list { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); margin: var(--space-3-5) 0; position: relative; }
  .menu-list li { display: flex; align-items: center; gap: var(--space-2); color: #F8E8FF; font-size: var(--text-body); }
  .menu-list li::before { content: ""; flex: none; width: 20px; height: 1.5px; background: var(--color-lemon); }

  .meta { position: relative; display: flex; gap: var(--space-4-5); flex-wrap: wrap; color: #F8E8FF; font-size: var(--text-tag); }
  .meta b { color: var(--color-lemon); }

  .arr { transition: var(--duration-base); display: inline-block; }
</style>
