---
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const perks = [
  { emoji: '🥂', title: 'Bottomless', body: 'Drinks package included with paint & sip ticket — wines, beers & mocktails.' },
  { emoji: '🍟', title: 'Poutine',    body: 'Chips, cheese curds, gravy. Stay for dinner after — it slaps.' },
  { emoji: '🎨', title: 'The studio', body: 'Easels lined up along the bar wall. Lighting? Vibes? Sorted.' },
  { emoji: '📍', title: 'Geelong CBD', body: 'Walking distance from the waterfront. Easy parking nearby.' },
];
---
<section class="astray" id="astray">
  <svg class="deco-svg" viewBox="0 0 400 200" aria-hidden="true">
    <path d="M-20 100 C 40 20, 100 180, 160 100 S 280 20, 340 100 S 460 180, 520 100" stroke="#F5CF3E" stroke-width="14" stroke-linecap="round" fill="none"/>
    <path d="M-20 100 C 40 20, 100 180, 160 100 S 280 20, 340 100 S 460 180, 520 100" stroke="#EC3B8E" stroke-width="8" stroke-linecap="round" fill="none" transform="translate(0,-20)"/>
  </svg>

  <div class="wrap">
    <div class="grid2">
      <div>
        <SectionHeading
          tag="in partnership with"
          title="Sip with us at<br>Astray Bar."
          tagColor="#6CD7C2"
          titleColor="#F5CF3E"
          align="left"
        />
        <p class="lede2 reveal reveal-d2">
          Our favourite place to host public events. Astray pours up bottomless drinks packages
          (their <b>mocktails</b> are absurd) and the <b>poutine</b> — chips, cheese curds, gravy —
          is genuinely the best post-painting dinner in Geelong.
        </p>

        <div class="perks">
          {perks.map((p, i) => (
            <div class={`perk reveal${i > 0 ? ` reveal-d${i + 1}` : ''}`}>
              <h4>{p.emoji} {p.title}</h4>
              <p>{p.body}</p>
            </div>
          ))}
        </div>

        <Button href="#events" variant="primary">See Astray events <span class="arr">→</span></Button>
      </div>

      <div class="astray-card reveal reveal-d2">
        <span class="label">Next session ✺</span>
        <h3>Cat Under <span>the Moon.</span></h3>
        <ul class="menu-list">
          <li>Sun 24 May · 4:30pm</li>
          <li>Astray Bar · Geelong CBD</li>
          <li>$100pp · drinks + canvas + 2.5h</li>
        </ul>
        <div class="meta">
          <span><b>Run by</b> Seekie Studios</span>
          <span><b>Hosted at</b> Astray Bar</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .astray {
    background: #4A1F8C; color: #FFF6E8;
    position: relative; overflow: hidden; padding: 110px 0; z-index: 2;
  }

  .deco-svg {
    position: absolute; top: 60px; right: -100px; width: 300px; opacity: .5;
    pointer-events: none;
  }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
  @media (max-width: 880px) { .grid2 { grid-template-columns: 1fr; } }

  .lede2 { font-size: 19px; color: #F8E8FF; max-width: 520px; line-height: 1.55; margin-bottom: 24px; }

  .perks { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin: 28px 0 32px; }
  .perk {
    background: rgba(255,255,255,.06); border: 1.5px solid rgba(245,207,62,.3);
    border-radius: 16px; padding: 16px 18px;
  }
  .perk h4 { font-family: "Caprasimo", serif; font-size: 18px; color: #F5CF3E; margin-bottom: 4px; }
  .perk p  { font-size: 14px; color: #F8E8FF; line-height: 1.4; }

  .astray-card {
    position: relative; aspect-ratio: 4/5;
    background: #2E0F5C; border: 3px solid #F5CF3E; border-radius: 24px;
    padding: 28px; display: flex; flex-direction: column; justify-content: flex-end;
    box-shadow: 0 24px 60px -10px rgba(0,0,0,.45); overflow: hidden;
  }
  .astray-card::before {
    content: ""; position: absolute; top: -12%; right: -15%; width: 65%; aspect-ratio: 1;
    background: #EC3B8E; border-radius: 55% 45% 60% 40%/45% 55% 45% 55%;
  }
  .astray-card::after {
    content: ""; position: absolute; left: -10%; bottom: -15%; width: 55%; aspect-ratio: 1;
    background: #F5CF3E; border-radius: 50%;
  }

  .label {
    position: relative; display: inline-block; align-self: flex-start; margin-bottom: auto;
    background: #F5CF3E; color: #4A1F8C;
    padding: 8px 14px; border-radius: 999px;
    font-family: "Bagel Fat One", serif; font-size: 14px; letter-spacing: .06em;
  }
  h3 {
    position: relative; font-family: "Bagel Fat One", serif; font-size: 48px;
    color: #FFF6E8; line-height: .95; margin-bottom: 14px;
  }
  h3 span { color: #F5CF3E; }

  .menu-list { list-style: none; display: flex; flex-direction: column; gap: 8px; margin: 14px 0; position: relative; }
  .menu-list li { display: flex; align-items: center; gap: 10px; color: #F8E8FF; font-size: 15px; }
  .menu-list li::before { content: ""; flex: none; width: 20px; height: 1.5px; background: #F5CF3E; }

  .meta { position: relative; display: flex; gap: 18px; flex-wrap: wrap; color: #F8E8FF; font-size: 14px; }
  .meta b { color: #F5CF3E; }

  .arr { transition: .2s; display: inline-block; }
</style>
