---
import '../styles/global.css';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import { resolveSettingsImage } from '../lib/settings-images';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const seoEntry = await getEntry('settings', 'seo');
const seo = (seoEntry?.data ?? {}) as {
  title?: string;
  description?: string;
  ogImage?: string | null;
  favicon?: string | null;
};

const {
  title = seo.title ?? 'Seekie Studios - Paint & Sip Parties · Geelong / Surf Coast / Bellarine',
  description = seo.description ?? 'Private mobile paint & sip parties across Geelong, the Surf Coast and the Bellarine. We come to you, fully BYO, custom paintings to suit your theme.',
  ogImage,
} = Astro.props;

const siteUrl = 'https://seekiestudios.com.au';
const canonical = new URL(Astro.url.pathname, siteUrl).href;

const ogImageMeta = await resolveSettingsImage(seo.ogImage);
let ogImageUrl: string | null = null;
if (ogImage) {
  ogImageUrl = new URL(ogImage, siteUrl).href;
} else if (ogImageMeta) {
  const optimised = await getImage({ src: ogImageMeta, width: 1200, height: 630, format: 'jpg' });
  ogImageUrl = new URL(optimised.src, siteUrl).href;
}

const faviconMeta = await resolveSettingsImage(seo.favicon);
const faviconUrl = faviconMeta?.src ?? '/favicon.svg';
const faviconType = (faviconMeta?.format ?? 'svg') === 'svg' ? 'image/svg+xml' : `image/${faviconMeta?.format ?? 'svg'}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

    <link rel="icon" type={faviconType} href={faviconUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&family=Caprasimo&family=DM+Sans:wght@400;500;600;700&family=Caveat:wght@500;700&display=swap"
    />
  </head>
  <body class="feed-ig">
    <slot />

    <script>
      const io = new IntersectionObserver(
        (entries) => entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
        { threshold: .12 }
      );
      document.querySelectorAll('.reveal').forEach(el => io.observe(el));

      document.querySelectorAll<HTMLButtonElement>('.feed-tabs button[data-feed]').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.feed-tabs button[data-feed]').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          document.body.classList.toggle('feed-ig', btn.dataset.feed === 'ig');
          document.body.classList.toggle('feed-fb', btn.dataset.feed === 'fb');
        });
      });
    </script>
  </body>
</html>
