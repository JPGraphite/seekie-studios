{
  "name": "seekie-studios",
  "main": "dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "compatibility_date": "2026-02-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "seekie.studios@gmail.com"
    }
  ],
  "routes": [
    {
      "pattern": "seekiestudios.com.au",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADMD7egQrvvZhij7",
    "KEYSTATIC_GITHUB_CLIENT_ID": "Iv23liReUIzwQlGOZiLE",
    "PUBLIC_KEYSTATIC_GITHUB_APP_SLUG": "seekie-studios"
  },
  "unsafe": {
    "bindings": [
      {
        "name": "CONTACT_RATE_LIMIT",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 5,
          "period": 60
        }
      }
    ]
  }
}
